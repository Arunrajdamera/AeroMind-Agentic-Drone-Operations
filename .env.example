# Application
AEROMIND_ENVIRONMENT=development
AEROMIND_LOG_LEVEL=INFO
AEROMIND_MOCK_MODE=true
AEROMIND_SIMULATION_SEED=42
AEROMIND_SIMULATION_LATITUDE=37.4200
AEROMIND_SIMULATION_LONGITUDE=-122.0800
AEROMIND_SIMULATION_RADIUS_M=1000
AEROMIND_SIMULATION_DRONE_COUNT=5

# Database (not required by the Phase 1 health endpoint)
AEROMIND_DATABASE_URL=postgresql+psycopg://aeromind:aeromind@postgres:5432/aeromind

# Model providers. Keep blank in mock mode; never commit real secrets.
AEROMIND_OPENAI_API_KEY=
AEROMIND_OPENAI_BASE_URL=
AEROMIND_EMBEDDING_PROVIDER=mock
AEROMIND_EMBEDDING_MODEL_NAME=mock-embedding-v1
# Required only when AEROMIND_EMBEDDING_PROVIDER=openai_compatible.
AEROMIND_EMBEDDING_API_KEY=
AEROMIND_EMBEDDING_BASE_URL=

# Optional LangSmith observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=aeromind
